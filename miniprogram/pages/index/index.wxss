}

.meal-confirm {
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  background: #fff0e4;
  color: #d45e4e;
  font-size: 25rpx;
  font-weight: 700;
  text-align: center;
}

.submit-content-fade {
  pointer-events: none;
  animation: submitContentFade 650ms ease-out forwards;
}

@keyframes submitContentFade {
  from {
    opacity: 1;
  }

  to {
    opacity: 0;
  }
}

.basket-dish-quantity {
  display: block;
  margin-top: 6rpx;
  color: rgba(255, 248, 228, 0.88);
  font-size: 22rpx;
}

.submitted-page {
  position: absolute;
  inset: 0;
  z-index: 55;
  box-sizing: border-box;
  padding: 150rpx 32rpx 150rpx;
  background: #fff3ec;
  animation: submittedPageIn 400ms ease-out both;
}

.submitted-title {
  display: block;
  color: #8b453b;
  font-size: 42rpx;
  font-weight: 700;
}

.submitted-subtitle {
  display: block;
  margin-top: 14rpx;
  color: #b77467;
  font-size: 25rpx;
}

.submitted-list {
  height: 65%;
  margin-top: 36rpx;
}

.submitted-time {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 127, 102, 0.14);
  color: #8b453b;
  font-size: 25rpx;
}

.submitted-time-value {
  margin-left: 20rpx;
  color: #b77467;
  text-align: right;
}

.continue-order-button {
  position: absolute;
  right: 32rpx;
  bottom: calc(44rpx + env(safe-area-inset-bottom));
  left: 32rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  background: #ff7f66;
  color: #fff8e4;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(255, 127, 102, 0.28);
  transition: transform 180ms ease, box-shadow 180ms ease;
}

@keyframes submittedPageIn {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 菜品图片铺满整张卡片 */
.menu-card {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 220rpx;
  padding: 24rpx;
  overflow: hidden;
  background: #51352e;
}

/* 覆盖原来的小方图样式 */
.menu-card .menu-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 0;
  box-shadow: none;
}

/* 左侧清晰，越往右越暗 */
.menu-card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(to right,
      rgba(25, 18, 16, 0.02) 0%,
      rgba(25, 18, 16, 0.25) 35%,
      rgba(25, 18, 16, 0.72) 70%,
      rgba(25, 18, 16, 0.85) 100%);
  pointer-events: none;
}

/* 文字从卡片中部开始，放在渐变层上方 */
.menu-card .menu-info {
  position: relative;
  z-index: 2;
  min-width: 0;
  margin-left: 38%;
  flex: 1;
}

.menu-card .menu-name,
.menu-card .menu-description {
  color: #fff8e4;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.5);
}

.menu-card .dish-choice {
  position: relative;
  z-index: 2;
  margin-left: 12rpx;
  flex: 0 0 92rpx;
}

.menu-card .menu-info {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 2;
  width: 60%;
  margin: 0;
  transform: translate(-50%, -50%);
  text-align: center;
  pointer-events: none;
}

.menu-card .menu-name,
.menu-card .menu-description {
  display: block;
  width: 100%;
  text-align: center;
}

.menu-card .dish-choice {
  position: absolute;
  right: 24rpx;
  top: 50%;
  z-index: 3;
  margin: 0;
  transform: translateY(-50%);
}

/* 给固定底栏留出空间，让菜品列表在其上方滚动 */
.menu-list {
  height: calc(100vh - 520rpx);
  margin-top: 24rpx;
}

/* 反馈按钮后面的滚动留白 */
.menu-bottom-space {
  height: 100rpx;
}

/* 滚动停止时尽量吸附到附近的菜品卡片 */
.menu-list {
  scroll-snap-type: y proximity;
}

.menu-card {
  scroll-snap-align: start;
}

.menu-card::before {
  transition: opacity 300ms ease;
}

.menu-card-focused::before {
  opacity: 0;
}
.menu-list {
  scroll-snap-type: none;
}