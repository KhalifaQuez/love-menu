page {
  height: 100vh;
  overflow: hidden;
  background: #1d1714;
}

.home {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #1d1714;
}

.banner {
  width: 100%;
  height: 100vh;
  opacity: 0;
  transition: opacity 900ms ease;
}

.banner-visible {
  opacity: 1;
}

.slide {
  position: relative;
  width: 100%;
  height: 100%;
  background-size: cover;
  background-repeat: no-repeat;
}

.slide-title,
.slide-subtitle {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  color: #fff0a8;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.82);
  z-index: 1;
}

.slide-title {
  top: 180rpx;
  font-size: 54rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.slide-subtitle {
  position: absolute;
  top: 290rpx;
  right: 48rpx;
  left: auto;
  color: #fff0a8;
  font-size: 30rpx;
  letter-spacing: 1rpx;
  text-align: right;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.82);
  z-index: 1;
}

.sheet {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  padding: 80rpx 32rpx 48rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;

  background: linear-gradient(to bottom,
      rgba(255, 250, 247, 0.06) 0,
      rgba(255, 250, 247, 0.42) 180rpx,
      rgba(255, 250, 247, 0.58) 100%);

  -webkit-backdrop-filter: blur(32px) saturate(135%);
  backdrop-filter: blur(32px) saturate(135%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.58);
  box-shadow: 0 -12rpx 42rpx rgba(57, 35, 27, 0.12);

  transition: transform 420ms cubic-bezier(0.22, 1.18, 0.36, 1);
}

.sheet-dragging {
  transition: none;
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}

.pull-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 56rpx;
  border-radius: 8rpx;
  background: rgba(61, 43, 31, 0.2);
}

.wish-button {
  width: 100%;
  height: 108rpx;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  border-radius: 54rpx;
  background: #ff7f66;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 30rpx rgba(255, 127, 102, 0.28);
}

.wish-button::after {
  border: none;
}

.sticky-button {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  z-index: 2;
  transform-origin: center bottom;
  transition: top 280ms ease-out, transform 180ms ease-out;
}



.sheet-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wish-button {
  position: relative;
  z-index: 1;
  transform-origin: center bottom;
}

.pull-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 74rpx;
  z-index: 3;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.pull-tip-text {
  color: #fff0a8;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.72);
}

.pull-tip-arrow {
  margin-top: 8rpx;
  color: #fff0a8;
  font-size: 42rpx;
  line-height: 42rpx;
  text-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.72);
  animation: pullHint 1.35s ease-in-out infinite;
}

@keyframes pullHint {

  0%,
  100% {
    transform: translateY(10rpx);
    opacity: 0.45;
  }

  50% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

.gummy-button {
  position: relative;
  width: 100%;
  height: 108rpx;
}

.wish-button {
  position: absolute;
  inset: 0;
  z-index: 2;
  transform-origin: center;
  transition: transform 90ms ease-out, box-shadow 90ms ease-out;
}

.wish-button-pressed {
  transform: scale(0.96);
  box-shadow:
    inset 0 9rpx 16rpx rgba(119, 45, 35, 0.34),
    inset 0 -4rpx 8rpx rgba(255, 255, 255, 0.16),
    0 8rpx 18rpx rgba(255, 127, 102, 0.2);
}

.wish-button-rebounding {
  animation: wishRebound 260ms cubic-bezier(0.18, 1.35, 0.42, 1) forwards;
}

@keyframes wishRebound {
  0% {
    transform: scale(0.96);
  }

  55% {
    transform: scale(1.035);
  }

  78% {
    transform: scale(0.99);
  }

  100% {
    transform: scale(1);
  }
}

.wish-button-rebounding {
  animation: wishRebound 380ms cubic-bezier(0.18, 1.35, 0.42, 1) forwards;
}

@keyframes wishRebound {
  0% {
    transform: scale(0.96);
  }

  52% {
    transform: scale(1.04);
  }

  76% {
    transform: scale(0.985);
  }

  100% {
    transform: scale(1);
  }
}

.wish-button-collapsing {
  right: auto;
  bottom: auto;
  overflow: hidden;
  pointer-events: none;
  animation: buttonToDot 650ms cubic-bezier(0.22, 0.82, 0.32, 1) forwards;
}

.wish-button-collapsing .wish-button-label {
  animation: buttonLabelFade 260ms ease-out forwards;
}

@keyframes buttonLabelFade {
  0% {
    opacity: 1;
  }

  100% {
    opacity: 0;
  }
}

@keyframes buttonToDot {
  0% {
    top: 0;
    left: 0;
    width: 100%;
    height: 108rpx;
    margin: 0;
    border-radius: 54rpx;
    transform: scale(1);
  }

  48% {
    top: 12rpx;
    left: 18%;
    width: 64%;
    height: 84rpx;
    margin: 0;
    border-radius: 50rpx;
    transform: scale(0.92);
  }

  100% {
    top: 50%;
    left: 50%;
    width: 30rpx;
    height: 30rpx;
    margin: -15rpx;
    border-radius: 50%;
    transform: scale(1);
    box-shadow: 0 8rpx 20rpx rgba(255, 127, 102, 0.48);
  }
}

.button-finale {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 3;
  width: 1rpx;
  height: 1rpx;
  pointer-events: none;
}

.orbit-dot {
  position: absolute;
  top: 0;
  left: 0;
  width: 30rpx;
  height: 30rpx;
  margin: -15rpx;
  border-radius: 50%;
  background: #ff7f66;
  box-shadow: 0 8rpx 20rpx rgba(255, 127, 102, 0.48);
  animation: dotOrbit 1600ms linear forwards;
}

@keyframes dotOrbit {
  0% {
    transform: translate(0, 0) scale(1);
    opacity: 1;
  }

  10% {
    transform: translate(0, -130rpx) scale(1);
  }

  13.33% {
    transform: translate(34rpx, -126rpx) scale(1);
  }

  16.67% {
    transform: translate(65rpx, -113rpx) scale(1);
  }

  20% {
    transform: translate(92rpx, -92rpx) scale(1);
  }

  23.33% {
    transform: translate(113rpx, -65rpx) scale(1);
  }

  26.67% {
    transform: translate(126rpx, -34rpx) scale(1);
  }

  30% {
    transform: translate(130rpx, 0) scale(1);
  }

  33.33% {
    transform: translate(126rpx, 34rpx) scale(1);
  }

  36.67% {
    transform: translate(113rpx, 65rpx) scale(1);
  }

  40% {
    transform: translate(92rpx, 92rpx) scale(1);
  }

  43.33% {
    transform: translate(65rpx, 113rpx) scale(1);
  }

  46.67% {
    transform: translate(34rpx, 126rpx) scale(1);
  }

  50% {
    transform: translate(0, 130rpx) scale(1);
  }

  53.33% {
    transform: translate(-34rpx, 126rpx) scale(1);
  }

  56.67% {
    transform: translate(-65rpx, 113rpx) scale(1);
  }

  60% {
    transform: translate(-92rpx, 92rpx) scale(1);
  }

  63.33% {
    transform: translate(-113rpx, 65rpx) scale(1);
  }

  66.67% {
    transform: translate(-126rpx, 34rpx) scale(1);
  }

  70% {
    transform: translate(-130rpx, 0) scale(1);
  }

  73.33% {
    transform: translate(-126rpx, -34rpx) scale(1);
  }

  76.67% {
    transform: translate(-113rpx, -65rpx) scale(1);
  }

  80% {
    transform: translate(-92rpx, -92rpx) scale(1);
  }

  83.33% {
    transform: translate(-65rpx, -113rpx) scale(1);
  }

  86.67% {
    transform: translate(-34rpx, -126rpx) scale(1);
  }

  90% {
    transform: translate(0, -130rpx) scale(1);
  }

  100% {
    transform: translate(0, 0) scale(0.72);
    opacity: 0;
  }
}

.bubble {
  position: absolute;
  top: 0;
  left: 0;
  width: 26rpx;
  height: 26rpx;
  margin: -13rpx;
  border: 2rpx solid rgba(255, 239, 210, 0.92);
  border-radius: 50%;
  background: rgba(255, 127, 102, 0.3);
  box-shadow: 0 0 18rpx rgba(255, 202, 149, 0.35);
  opacity: 0;
}

.bubble-one {
  animation: burstOne 800ms ease-out forwards;
}

.bubble-two {
  animation: burstTwo 760ms 30ms ease-out forwards;
}

.bubble-three {
  animation: burstThree 820ms 20ms ease-out forwards;
}

.bubble-four {
  animation: burstFour 780ms 40ms ease-out forwards;
}

.bubble-five {
  animation: burstFive 810ms ease-out forwards;
}

.bubble-six {
  animation: burstSix 770ms 25ms ease-out forwards;
}

.bubble-seven {
  animation: burstSeven 830ms 15ms ease-out forwards;
}

.bubble-eight {
  animation: burstEight 790ms 35ms ease-out forwards;
}

@keyframes burstOne {
  0% {
    transform: scale(0.2);
    opacity: 0;
  }

  18% {
    opacity: 0.9;
  }

  100% {
    transform: translate(-560rpx, -820rpx) scale(2.1);
    opacity: 0;
  }
}

@keyframes burstTwo {
  0% {
    transform: scale(0.2);
    opacity: 0;
  }

  18% {
    opacity: 0.82;
  }

  100% {
    transform: translate(530rpx, -720rpx) scale(1.6);
    opacity: 0;
  }
}

@keyframes burstThree {
  0% {
    transform: scale(0.2);
    opacity: 0;
  }

  18% {
    opacity: 0.85;
  }

  100% {
    transform: translate(640rpx, -80rpx) scale(2);
    opacity: 0;
  }
}

@keyframes burstFour {
  0% {
    transform: scale(0.2);
    opacity: 0;
  }

  18% {
    opacity: 0.8;
  }

  100% {
    transform: translate(530rpx, 650rpx) scale(1.8);
    opacity: 0;
  }
}

@keyframes burstFive {
  0% {
    transform: scale(0.2);
    opacity: 0;
  }

  18% {
    opacity: 0.9;
  }

  100% {
    transform: translate(0, 850rpx) scale(2.2);
    opacity: 0;
  }
}

@keyframes burstSix {
  0% {
    transform: scale(0.2);
    opacity: 0;
  }

  18% {
    opacity: 0.82;
  }

  100% {
    transform: translate(-540rpx, 660rpx) scale(1.7);
    opacity: 0;
  }
}

@keyframes burstSeven {
  0% {
    transform: scale(0.2);
    opacity: 0;
  }

  18% {
    opacity: 0.86;
  }

  100% {
    transform: translate(-650rpx, 100rpx) scale(2);
    opacity: 0;
  }
}

@keyframes burstEight {
  0% {
    transform: scale(0.2);
    opacity: 0;
  }

  18% {
    opacity: 0.8;
  }

  100% {
    transform: translate(-250rpx, -920rpx) scale(1.6);
    opacity: 0;
  }
}

.completion-fill {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 20;
  width: 120rpx;
  height: 120rpx;
  margin: -60rpx;
  border-radius: 50%;
  background: #ff7f66;
  box-shadow: 0 0 80rpx rgba(255, 127, 102, 0.56);
  pointer-events: none;
  animation: fillScreen 700ms cubic-bezier(0.22, 0.8, 0.32, 1) forwards;
}

@keyframes fillScreen {
  0% {
    transform: scale(0.25);
    opacity: 0.9;
  }

  100% {
    transform: scale(22);
    opacity: 1;
  }
}

.menu-page {
  position: absolute;
  inset: 0;
  z-index: 21;
  box-sizing: border-box;
  padding: 128rpx 32rpx 0;
  pointer-events: auto;
}

.menu-header {
  box-sizing: border-box;
  min-height: 214rpx;
  padding: 32rpx 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.52);
  border-radius: 30rpx;
  background: rgba(255, 247, 239, 0.2);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.48),
    0 16rpx 34rpx rgba(122, 56, 46, 0.16);
  -webkit-backdrop-filter: blur(18px) saturate(125%);
  backdrop-filter: blur(18px) saturate(125%);
  animation: menuHeaderIn 620ms cubic-bezier(0.2, 0.8, 0.3, 1) both;
}

.menu-kicker {
  display: block;
  color: rgba(255, 249, 225, 0.8);
  font-size: 20rpx;
  letter-spacing: 4rpx;
}

.menu-title {
  display: block;
  margin-top: 16rpx;
  color: #fff8e4;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.menu-subtitle {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 249, 225, 0.84);
  font-size: 26rpx;
}

.menu-list {
  height: calc(100vh - 370rpx);
  margin-top: 24rpx;
}

.menu-card {
  display: flex;
  align-items: center;
  min-height: 192rpx;
  margin-bottom: 22rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 28rpx;
  background: rgba(255, 247, 239, 0.2);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.42),
    0 14rpx 30rpx rgba(122, 56, 46, 0.13);
  -webkit-backdrop-filter: blur(18px) saturate(125%);
  backdrop-filter: blur(18px) saturate(125%);
  opacity: 0;
  animation: menuCardIn 560ms cubic-bezier(0.2, 0.85, 0.32, 1) both;
}

.menu-image {
  width: 156rpx;
  height: 156rpx;
  flex: none;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 18rpx rgba(70, 28, 21, 0.18);
}

.menu-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  margin-left: 26rpx;
}

.menu-name {
  color: #fff8e4;
  font-size: 34rpx;
  font-weight: 700;
}

.menu-description {
  margin-top: 12rpx;
  color: rgba(255, 249, 225, 0.82);
  font-size: 24rpx;
  line-height: 1.6;
}

.menu-bottom-space {
  height: 220rpx;
}

@keyframes menuHeaderIn {
  from {
    opacity: 0;
    transform: translateY(-32rpx) scale(0.96);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes menuCardIn {
  from {
    opacity: 0;
    transform: translateY(42rpx) scale(0.96);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.category-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.category-switch {
  padding: 12rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 999rpx;
  color: rgba(255, 249, 225, 0.9);
  font-size: 22rpx;
}



.wheel-title {
  display: block;
  color: #fff8e4;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}

.category-picker {
  width: 100%;
  height: 210rpx;
  margin-top: 8rpx;
}


.wheel-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 6rpx;
}

.wheel-cancel,
.wheel-confirm {
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
}

.wheel-cancel {
  color: rgba(255, 249, 225, 0.8);
  background: rgba(255, 255, 255, 0.12);
}

.wheel-confirm {
  color: #ff7f66;
  font-weight: 700;
  background: #fff8e4;
}

.menu-empty {
  margin-top: 110rpx;
  text-align: center;
  animation: menuCardIn 420ms ease-out both;
}

.menu-empty-title {
  display: block;
  color: #fff8e4;
  font-size: 38rpx;
  font-weight: 700;
}

.menu-empty-subtitle {
  display: block;
  margin-top: 20rpx;
  color: rgba(255, 249, 225, 0.8);
  font-size: 26rpx;
}

.category-wheel-card {
  min-height: 680rpx;
  padding: 28rpx 36rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.52);
  border-radius: 30rpx;
  background: rgba(255, 247, 239, 0.2);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.48),
    0 16rpx 34rpx rgba(122, 56, 46, 0.16);
  -webkit-backdrop-filter: blur(18px) saturate(125%);
  backdrop-filter: blur(18px) saturate(125%);
  animation: menuHeaderIn 360ms ease-out both;
}

.wheel-title {
  display: block;
  color: #fff8e4;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
}

.category-wheel {
  position: relative;
  width: 510rpx;
  height: 510rpx;
  margin: 12rpx auto 0;
}

.wheel-ring {
  position: absolute;
  inset: 0;
  transition: transform 260ms cubic-bezier(0.2, 0.8, 0.3, 1);
}

.wheel-ring.wheel-dragging {
  transition: none;
}

.wheel-item {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 120rpx;
  height: 54rpx;
  margin: -27rpx 0 0 -60rpx;
  transform-origin: 60rpx 27rpx;
}

.wheel-label {
  display: block;
  width: 120rpx;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 27rpx;
  color: rgba(255, 249, 225, 0.74);
  font-size: 24rpx;
  text-align: center;
  transition: color 180ms ease, background 180ms ease;
}

.wheel-item-active .wheel-label {
  opacity: 0;
}

.wheel-center {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  width: 190rpx;
  height: 190rpx;
  margin: -95rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 50%;
  background: rgba(255, 248, 228, 0.24);
  box-shadow:
    inset 0 2rpx 10rpx rgba(255, 255, 255, 0.32),
    0 10rpx 24rpx rgba(92, 36, 28, 0.16);
}

.wheel-center-label {
  color: rgba(255, 249, 225, 0.7);
  font-size: 20rpx;
}

.wheel-center-value {
  margin-top: 10rpx;
  color: #fff8e4;
  font-size: 36rpx;
  font-weight: 700;
}

.wheel-actions {
  display: flex;
  justify-content: space-between;
  margin-top: -10rpx;
}

.wheel-focus {
  position: absolute;
  top: 4rpx;
  left: 50%;
  z-index: 4;
  width: 150rpx;
  height: 62rpx;
  margin-left: -75rpx;
  border-radius: 31rpx;
  background: #fff8e4;
  box-shadow: 0 8rpx 18rpx rgba(92, 36, 28, 0.2);
}

.wheel-focus text {
  display: block;
  color: #ff7f66;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 62rpx;
  text-align: center;
}

.wheel-focus-active {
  animation: wheelFocusPop 150ms cubic-bezier(0.2, 1.5, 0.4, 1);
}

@keyframes wheelFocusPop {
  0% {
    transform: scale(1);
  }

  55% {
    transform: scale(1.16);
  }

  100% {
    transform: scale(1);
  }
}

/* 菜品右侧的想吃按钮 */
.dish-choice {
  width: 116rpx;
  height: 64rpx;
  margin-left: 16rpx;
  padding: 0;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 32rpx;
  background: rgba(255, 248, 228, 0.16);
  color: #fff8e4;
  font-size: 24rpx;
  font-weight: 700;
  line-height: normal;
  box-shadow: 0 8rpx 18rpx rgba(113, 48, 37, 0.1);
  transition: transform 90ms ease-out, background 160ms ease, color 160ms ease;
}

.dish-choice::after,
.order-button::after {
  border: none;
}

.dish-choice-selected {
  border-color: #fff8e4;
  background: #fff8e4;
  color: #ff7f66;
  box-shadow: 0 8rpx 18rpx rgba(92, 36, 28, 0.2);
}

.dish-choice-pressed,
.order-button-pressed {
  transform: scale(0.96);
  box-shadow:
    inset 0 6rpx 12rpx rgba(92, 36, 28, 0.18),
    0 4rpx 10rpx rgba(92, 36, 28, 0.1);
}

.dish-choice-rebounding,
.order-button-rebounding {
  animation: orderButtonRebound 240ms cubic-bezier(0.18, 1.35, 0.42, 1) forwards;
}

@keyframes orderButtonRebound {
  0% {
    transform: scale(0.96);
  }

  56% {
